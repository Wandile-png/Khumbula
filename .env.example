# ---- Required ----
DATABASE_URL="postgresql://user:password@host:5432/khumbula?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/khumbula?sslmode=require"  # Neon on Vercel sets both automatically
APP_URL="https://your-app.vercel.app"          # public address, used for payment return and webhook URLs
SESSION_SECRET="at-least-32-random-characters"   # openssl rand -base64 48
DATA_KEY="32-bytes-base64"                       # openssl rand -base64 32  (encrypts ID numbers — never change once in use)
SETUP_KEY="a-long-password-for-/setup"
CRON_SECRET="random-string"                      # Vercel sends this to the daily billing job

# Optional: send visitors straight to one funeral home
# DEFAULT_TENANT="ekuthuleni"

# ---- PayFast (card subscriptions and Instant EFT) ----
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"                          # set to false when live

# ---- Paystack (alternative card gateway) ----
PAYSTACK_SECRET_KEY=""
MEMBER_EMAIL_DOMAIN="yourdomain.co.za"          # placeholder emails for members without one

# ---- Netcash DebiCheck (leave blank for manual mode) ----
NETCASH_DEBICHECK_SERVICE_KEY=""
NETCASH_WEBHOOK_SECRET=""

# ---- Messaging ----
MESSAGING_DRY_RUN="true"                        # logs instead of sending; set false when providers are configured
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
BULKSMS_TOKEN_ID=""
BULKSMS_TOKEN_SECRET=""
BULKSMS_SENDER=""
